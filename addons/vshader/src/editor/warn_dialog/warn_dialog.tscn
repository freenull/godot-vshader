bbcode_enabled = true
text = "[p]The source code of this variant-enabled shader declares [b]1[/b] possible permutations of variant options.[/p][br][p]Pre-filling the entire shader cache requires generating 1 [code]Shader[/code] instances, each with a separate copy of the source code. Each of these shaders will have to be loaded along with the [code]VariantShader[/code] resource in-game. Large caches like this may have a significant effect on loading times, RAM usage and disk usage.[/p][br][p][b]Are you sure you want to continue?[/b][br]Pressing [i]Cancel[/i] will suspend recompilation until you re-enable it or recompile manually.[br]Pressing [i]OK[/i] will continue generation and disable this confirmation dialog.[br][/p][br][p][b]Note:[/b] You can use the [code]exclusions[/code] property to narrow down the permutation set.[/p]"
fit_content = true

