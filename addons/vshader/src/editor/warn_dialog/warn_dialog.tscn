text = "[p]The dangerous threshold is configured as 1 through the [code]addons/vshader/dangerous_permutation_count[/code] project setting. You can control whether this message appears through the [code]auto_recompilation_mode[/code] property on the resource.[/p][br][p]If you select [i]Cancel[/i], shaders with specific variant options can still be generated on demand.[/p]"
fit_content = true
