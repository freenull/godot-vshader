@tool
extends Resource
class_name VariantShader

class Promise:
	signal emitted(which: Signal)
	
	func _init(signals: Array[Signal]):
		for sig in signals:
			sig.connect(func(): _emit(sig))
	
	func _emit(which: Signal):
		emitted.emit(which)

const DANGEROUS_PERMUTATION_COUNT_THRESHOLD := 1024

var _variants: Array[VariantShaderVariant]

@export_tool_button("Recompile", "Reload")
var _recompile_all = recompile_all

## When enabled, if the shader permutation count for the next generation is detected to exceed 1024,
## a confirmation dialog will be displayed to continue generation or temporarily suspend it.[br]
## If generation is continued, this flag is automatically disabled.
@export
var warn_on_dangerous_permutation_count: bool = true

## While enabled, changes to the base shader or other parameters will not trigger regeneration of
## shader permutations.
@export
var suspend_recompilation: bool = false:
	set(value):
		suspend_recompilation = value
		if not suspend_recompilation:
			recompile_all()

## Excludes generating permutations which contain certain options of variants.
## [br][br]Entries are of the form [code]VARIANT=OPTION[/code] (exclude specific option of
## specific variant) or [code]VARIANT=*[/code] (exclude all options of the variant except
## the default option). Multiple entries for the same [code]VARIANT[/code] may be specified.
@export
var excluded_options: Array[String] = []:
	set(value):
		excluded_options = value
		recompile_all()

## Reference shader object containing source code with variant declarations.
@export
var base_shader: Shader:
	set(value):
		if base_shader != null:
			base_shader.changed.disconnect(recompile_all)
		base_shader = value
		if base_shader != null:
			base_shader.changed.connect(recompile_all)
		
		recompile_all()

## Dictionary of all generated shader permutations.
@export_custom(PROPERTY_HINT_TYPE_STRING, "", PROPERTY_USAGE_READ_ONLY | PROPERTY_USAGE_EDITOR)
var shader_cache: Dictionary[String, Shader]

@export_storage
var _secondary_paths: Dictionary[String, PackedStringArray] = {}

static func _parse_variant_def_enum(variant_def: String) -> VariantShaderVariant:
	var elems := variant_def.split(" ", false)
	if elems.size() == 0:
		push_warning("VariantShader: invalid definition of variant: missing name")
		return null
		
	var name := elems[0]
	elems.remove_at(0)
	
	if elems.size() == 0:
		push_warning("VariantShader: invalid definition of variant ", name, ": missing options")
		return null
	
	var variant := VariantShaderVariant.new()
	variant.name = name
	variant.values = elems
	return variant

func _get_secondary_variant_paths(variant_name: String) -> PackedStringArray:
	if _secondary_paths.has(variant_name):
		return _secondary_paths[variant_name]
	return []

func _parse_variant_def_module(name: String, pattern: String, shader_path: String) -> VariantShaderVariant:
	var dir_path: String
	if pattern.is_absolute_path():
		dir_path = pattern.get_base_dir()
	elif shader_path != "":
		dir_path = shader_path.get_base_dir().path_join(pattern).get_base_dir()
	
	var file_pattern = pattern.get_file()
	
	var matching_files = []
	
	var variant := VariantShaderVariant.new()
	variant.type = VariantShaderVariant.Type.PATH
	variant.name = name
	
	for file in DirAccess.get_files_at(dir_path):
		if not file.match(file_pattern): continue
		variant.values.append(dir_path.path_join(file))
	
	for secondary_path in _get_secondary_variant_paths(name):
		if not DirAccess.dir_exists_absolute(secondary_path):
			push_error("VariantShader: secondary path for variant ", name, " does not exist: ", secondary_path)
			continue
		for file in DirAccess.get_files_at(secondary_path):
			if not file.match(file_pattern): continue
			variant.values.append(secondary_path.path_join(file))
	
	if variant.values.size() == 0:
		variant.values.append("NONE")
	
	return variant

func _parse_variant_def_typed(variant_def: String, shader_path: String) -> VariantShaderVariant:
	var elems := variant_def.split(":", true, 1)
	if elems.size() == 0:
		push_warning("VariantShader: invalid definition of variant: missing name")
		return null
	var name := elems[0].strip_edges()
	
	if name.contains(" "):
		push_warning("VariantShader: invalid definition of variant: invalid name '", name, "'")
		return null
	
	if elems.size() == 1:
		push_warning("VariantShader: invalid definition of variant ", name, ": missing type specifier")
		return null
	
	var type_spec := elems[1].strip_edges()
	var type_name := type_spec
	var type_arg := ""
	var param_start_idx := type_spec.find("(")
	if param_start_idx >= 0:
		if not type_spec.ends_with(")"):
			push_warning("VariantShader: invalid definition of variant ", name, ": invalid type specifier '", type_spec, "'")
			return null
		type_name = type_spec.substr(0, param_start_idx)
		type_arg = type_spec.substr(param_start_idx + 1, type_spec.length() - type_name.length() - 2)
	
	if type_name.contains(" "):
		push_warning("VariantShader: invalid definition of variant ", name, ": invalid type name '", type_name, "'")
		return null
	
	if type_name == "module":
		if type_arg == "":
			push_warning("VariantShader: invalid definition of variant ", name, ": include() variants require an argument")
			return null
		
		return _parse_variant_def_module(name, type_arg, shader_path)
	else:
		push_warning("VariantShader: invalid definition of variant ", name, ": unknown type name '", type_name, "'")
		return null
		

func _parse_variant_def(variant_def: String, shader_path: String) -> VariantShaderVariant:
	if variant_def.contains(":"): return _parse_variant_def_typed(variant_def, shader_path)
	return _parse_variant_def_enum(variant_def)
	

func _parse_variants(code: String, shader_path: String) -> Array[VariantShaderVariant]:
	var variants: Array[VariantShaderVariant] = []
	
	var lineno = 0
	for line in code.split("\n"):
		lineno += 1
		line = line.strip_edges()
		if not line.begins_with("//"):
			continue
		line = line.substr(2)
		line = line.strip_edges(true, false)
		if not line.begins_with("@variant"): continue
		line = line.substr("@variant".length())
		line = line.strip_edges(true, false)
		var variant := _parse_variant_def(line, shader_path)
		if variant != null: variants.append(variant)
		else:
			push_warning("VariantShader: failed parsing variant definition at line ", lineno)
	
	return variants
		

func _compile_permutations(args: Array[String]):
	if args.size() >= _variants.size():
		_compile_cached(args)
		return
	
	var next_variant_idx = args.size()
	var variant := _variants[next_variant_idx]
	for option in variant.values:
		if is_excluded(variant, option):
			continue
		var args_perm := args.duplicate()
		args_perm.append(option)
		_compile_permutations(args_perm)

func _cache_key(args: Array[String]) -> Variant:
	var id_string := ""
	var first := true
	var idx := 0
	for value_key in args:
		if idx >= _variants.size():
			push_warning("VariantShader: number of args passed to _compile is larger than number of variants")
			break
		var variant := _variants[idx]
		
		if is_excluded(variant, value_key):
			push_warning("VariantShader: value '", value_key, "' of variant '", variant.name, "' is excluded and cannot be used")
			return null
			
		if variant.get_value(value_key) < 0:
			return null
		
		if not first:
			id_string += ","
		id_string += variant.name
		id_string += "="
		id_string += value_key
		first = false
		idx += 1
	
	return id_string

func _fix_include_path(include_path: String, shader_path: String) -> String:
	if shader_path == "": return include_path
	
	if include_path.is_absolute_path():
		return include_path
	
	return str(shader_path.get_base_dir(), "/", include_path)

func _preprocess(code: String, shader_path: String, args: Array[String]) -> String:
	var lines := code.split("\n")
	
	var in_erased_region: bool = false
	
	var lines_to_remove: Array[int] = []
	for i in range(lines.size()):
		if in_erased_region:
			lines_to_remove.append(i)
			
		var line := lines[i].strip_edges()
		if line.begins_with("//"):
			line = line.substr(2).strip_edges(true, false)
			if line.begins_with("@variant"):
				lines_to_remove.append(i)
			elif line.begins_with("@module"):
				line = line.substr("@module".length()).strip_edges(true, false)
				
				var variant_idx: int = -1
				
				for j in range(_variants.size()):
					if _variants[j].name == line:
						variant_idx = j
						break
						
				if variant_idx >= 0 and variant_idx < args.size():
					in_erased_region = true
					lines[i] = str("#include \"", args[variant_idx].c_escape(), "\"")
			elif line.begins_with("@endmodule"):
				in_erased_region = false
		elif line.begins_with("#"):
			line = line.substr(1).strip_edges(true, false)
			if line.begins_with("include"):
				line = line.substr("include".length()).strip_edges()
				if (line.begins_with("\"") and line.ends_with("\"")) or (line.begins_with("<") and line.ends_with(">")):
					line = line.substr(1, line.length() - 2)
					var include_path := _fix_include_path(line.c_unescape(), shader_path)
					lines[i] = str("#include \"", include_path, "\"")
	
	for i in range(lines_to_remove.size() - 1, -1, -1):
		lines.remove_at(lines_to_remove[i])
		
	return "\n".join(lines)

func _compile_uncached(args: Array[String]) -> Shader:
	if base_shader == null:
		push_warning("VariantShader: cannot compile variant because base_shader is unset")
		return null
	var prefix := ""
	var idx := 0
	
	var encountered_symbols: Dictionary[String, bool] = {}
	
	for value_key in args:
		if idx >= _variants.size():
			push_warning("VariantShader: number of args passed to _compile is larger than number of variants")
			break
		var variant := _variants[idx]
		if variant.is_ephemeral(): continue
		if is_excluded(variant, value_key):
			push_warning("VariantShader: value '", value_key, "' of variant '", variant.name, "' is excluded and cannot be used")
			continue
		var value_int := variant.get_value(value_key)
		if value_int < 0:
			push_warning("VariantShader: value '", value_key, "' is not a valid option for variant '", variant.name, "'")
			continue
		
		var macro_name := variant.name + "_" + value_key
		if encountered_symbols.has(macro_name):
			push_warning("VariantShader: invalid name of variant '", variant.name, "' option '", value_key, "': the resulting symbol '", macro_name, "' is already generated by a previous variant or option")
			continue
		
		encountered_symbols[macro_name] = true
		prefix += "#define " + macro_name + "\n"
				
		idx += 1
	
	var shader := Shader.new()
	shader.code = prefix + _preprocess(base_shader.code, base_shader.resource_path, args)
	return shader

func _compile_cached(args: Array[String]) -> Shader:
	var key := _cache_key(args)
	if key == null:
		return null
	if shader_cache.has(key):
		return shader_cache[key]
		
	var shader := _compile_uncached(args)
	if shader == null: return null
	shader_cache[key] = shader
	return shader

func _get_permutation_count() -> int:
	var count := 1
	for variant in _variants:
		var usable_options := variant.values.size()
		for value in variant.values:
			if is_excluded(variant, value): usable_options -= 1
		count *= usable_options
	
	return count

func compile(params: Dictionary[String, String], ignore_missing: bool = false) -> Shader:
	var args: Array[String] = []
	for variant in _variants:
		# first option = oifault
		args.append(variant.get_key(0))
		
	for variant_key in params.keys():
		var variant_idx := 0
		for variant in _variants:
			if variant.name == variant_key:
				break 
			variant_idx += 1
		
		if variant_idx >= _variants.size():
			if not ignore_missing:
				push_warning("VariantShader: invalid variant key '", variant_key, "' passed to compile()")
			continue
		
		args[variant_idx] = params[variant_key]
	
	return _compile_cached(args)
	
func get_shader(params: Dictionary[String, String], ignore_missing: bool = false) -> Shader:
	if base_shader == null:
		return null
		
	var args: Array[String] = []
	for variant in _variants:
		# first option = oifault
		args.append(variant.get_key(0))
		
	for variant_key in params.keys():
		var variant_idx := 0
		for variant in _variants:
			if variant.name == variant_key:
				break 
			variant_idx += 1
		
		if variant_idx >= _variants.size():
			if not ignore_missing:
				push_warning("VariantShader: invalid variant key '", variant_key, "' passed to compile()")
			continue
		
		args[variant_idx] = params[variant_key]
	
	var key := _cache_key(args)
	if key == null: return null
	return shader_cache[key]

func try_compile(params: Dictionary[String, String], ignore_missing: bool = false) -> Shader:
	if base_shader == null: return
	return compile(params, ignore_missing)

func recompile_all():
	if suspend_recompilation:
		return
		
	shader_cache = {}
	if base_shader == null:
		_variants = []
		return
	
	_variants = _parse_variants(base_shader.code, base_shader.resource_path)
	
	if warn_on_dangerous_permutation_count:
		var permutation_count := _get_permutation_count()
		if permutation_count >= DANGEROUS_PERMUTATION_COUNT_THRESHOLD:
			var vshader_desc := ""
			if resource_path != "":
				vshader_desc = str(" (", resource_path, ")")
			
			var dialog := ConfirmationDialog.new()
			dialog.title = "Dangerous number of VariantShader permutations"
			dialog.dialog_text = str(
				"Compiling this VariantShader", vshader_desc, " will lead to ", permutation_count, " shader permutations being generated.\n",
				"Each permutation is a separate Shader instance with a separate copy of the source code. This may have a significant effect on RAM usage, disk usage and loading speed.\n",
				"Are you sure you want to continue?\n",
				"Aborting will suspend recompilation. You can enable it back through the suspend_recompilation property.\n",
				"Accepting will continue generation and disable this confirmation dialog for this shader."
			)
			EditorInterface.get_base_control().add_child(dialog)
			
			dialog.popup_centered()
			var which = await Promise.new([dialog.confirmed, dialog.canceled]).emitted
			var do_continue = which == dialog.confirmed
			dialog.queue_free()
			
			if do_continue:
				warn_on_dangerous_permutation_count = false
			else:
				suspend_recompilation = true
				push_warning("VariantShader: recompilation suspended as user rejected generating ", permutation_count, " shaders")
				return
	
	if _variants.size() == 0:
		shader_cache[""] = base_shader
	else:
		_compile_permutations([])
	changed.emit()

func has_variant(name: String) -> bool:
	for variant in _variants:
		if variant.name == name:
			return true
	return false

func try_get_variant(name: String) -> VariantShaderVariant:
	for variant in _variants:
		if variant.name == name:
			return variant
	return null

func variants() -> Array[VariantShaderVariant]:
	return _variants

func is_excluded(variant: VariantShaderVariant, value: String):
	var needle = str(variant.name, "=", value)
	for excluded_option in excluded_options:
		if excluded_option == needle: return true
		# X=* must leave behind the default value otherwise no permutation can be constructed
		# Only an explicit X=Y can disable the default value
		if variant.get_value(value) != 0 and needle.match(excluded_option): return true
	return false

static func create_from_shader(shader: Shader) -> VariantShader:
	var vshader := new()
	vshader.base_shader = shader
	return vshader

func _get_property_list() -> Array[Dictionary]:
	var props: Array[Dictionary] = []
	
	for variant in _variants:
		if variant.type == VariantShaderVariant.Type.PATH:
			props.append({
				"name": str("secondary_variant_paths/", variant.name.to_lower()),
				"type": TYPE_PACKED_STRING_ARRAY
			})
	
	return props

func _get(property: StringName) -> Variant:
	if not property.begins_with("secondary_variant_paths/"):
		return null
	var variant_name := property.substr("secondary_variant_paths/".length()).to_upper()
	
	if not _secondary_paths.has(variant_name):
		return PackedStringArray([])
	return _secondary_paths[variant_name]

var _property_refresh_timer: SceneTreeTimer = null

func _update_secondary_variant_paths():
	notify_property_list_changed()
	_property_refresh_timer = null
	recompile_all()

func _set(property: StringName, value: Variant) -> bool:
	if not property.begins_with("secondary_variant_paths/"):
		return false
	var variant_name := property.substr("secondary_variant_paths/".length()).to_upper()
	
	_secondary_paths[variant_name] = value as PackedStringArray
	
	if _property_refresh_timer != null:
		_property_refresh_timer.timeout.disconnect(_update_secondary_variant_paths)
		
	_property_refresh_timer = (Engine.get_main_loop() as SceneTree).create_timer(2.0)
	_property_refresh_timer.timeout.connect(_update_secondary_variant_paths)
	
	return true
		
	
